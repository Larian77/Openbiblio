# Timezone for the PHP container (e.g. Europe/Berlin, America/New_York, UTC)
TZ=Europe/Berlin

# Database connection — must match the credentials the MySQL/MariaDB container is initialised with
# password for the application database user
DB_NAME=openbiblio
DB_USER=openbiblio
DB_PASSWORD=openbiblio
# password for the MySQL/MariaDB root account
MYSQL_ROOT_PASSWORD=rootpassword

# Locale used for the OpenBiblio UI and domain data on first install (e.g. de, en)
DB_LOCALE=de

# Set to "yes" to load sample catalogue data during automated install
INSTALL_TEST_DATA=no

# Initial password for the built-in "admin" account.
# Must be 8–20 characters and contain at least one digit, one letter,
# and one special character from: @_#§%$
# Leave blank to skip automated install and run the web wizard manually
# at http://localhost:8989/install/index.php — the password is then chosen there.
# IMPORTANT: if the password contains special characters (e.g. # or $), wrap it in quotes:
#   INITIAL_ADMIN_PASSWORD="My#Secret1"
INITIAL_ADMIN_PASSWORD=

# Secret key required to run the database upgrade wizard.
# Set this to a long random string; keep it private.
OBIB_UPGRADE_KEY=Your_own_Upgrade_Key

# Secret key used to sign password-forgotten recovery links.
# Set this to a long random string; keep it private.
OBIB_PWD_FORGOTTEN_KEY=Another_Upgrade_Key
